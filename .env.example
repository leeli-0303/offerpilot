# OfferPilot LLM 配置模板
# 复制此文件为 .env 并填入真实值

# LLM 模式：mock（默认，不调 API）或 real（调用真实 API）
# 注意：你也可以在应用内的「AI 模型配置」面板配置自己的 API，无需改 .env
LLM_MODE=mock

# ── 以下配置仅在 LLM_MODE=real 时生效 ────────────────────────────────

# API 提供商标识（仅用于显示，不影响调用）
LLM_PROVIDER=zhipu

# API Key
# 智谱：https://open.bigmodel.cn/ → 控制台 → API Keys
# DeepSeek：https://platform.deepseek.com/ → API Keys
LLM_API_KEY=your-api-key-here

# API 端点 Base URL（OpenAI 兼容接口）
# 智谱 GLM：https://open.bigmodel.cn/api/paas/v4/
# DeepSeek：https://api.deepseek.com/v1
# OpenAI：https://api.openai.com/v1
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/

# 模型名称
# 智谱推荐：glm-4-air（高性价比）或 glm-4-plus（更强）
# DeepSeek：deepseek-chat
# OpenAI：gpt-4o
LLM_MODEL_NAME=glm-4-air

# 生成参数
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
